/* ===== 分类页：层级树 ===== */

.ct-wrap {
  margin: 4px auto 8px;
  max-width: 640px;
  overflow-x: clip;
}

.ct-wrap *,
.ct-wrap *::before,
.ct-wrap *::after {
  box-sizing: border-box;
}

.ct-head {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 20px;
  font-size: 13px;
  letter-spacing: 0.02em;
  color: var(--text-color);
  opacity: 0.6;
}

.ct-head b {
  font-weight: 600;
  font-size: 15px;
  color: var(--theme-color);
  opacity: 1;
}

.ct-sep {
  opacity: 0.4;
}

.ct-root,
.ct-sub {
  list-style: none;
  margin: 0;
  padding: 0;
}

.ct-root > .ct-node {
  margin-bottom: 10px;
}

.ct-node {
  position: relative;
}

/* 一级分类条目 */
.ct-link {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 14px 18px;
  border-radius: 10px;
  background: var(--content-bg-color);
  border: 1px solid rgba(128, 128, 128, 0.16);
  border-left: 3px solid rgba(128, 128, 128, 0.2);
  color: var(--text-color);
  text-decoration: none;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
  transition: background 0.22s ease, border-color 0.22s ease, padding-left 0.22s ease,
    color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
}

.ct-link:hover {
  border-left-color: var(--theme-color);
  border-color: rgba(128, 128, 128, 0.24);
  padding-left: 22px;
  color: var(--text-color);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.07);
}

.ct-name {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.4;
  overflow-wrap: break-word;
}

.ct-count {
  flex: none;
  min-width: 26px;
  padding: 1px 9px;
  border-radius: 11px;
  background: rgba(128, 128, 128, 0.12);
  color: var(--text-color);
  font-size: 12px;
  font-weight: 500;
  line-height: 20px;
  text-align: center;
  opacity: 0.8;
}

.ct-link:hover .ct-count {
  background: var(--theme-color);
  color: #fff;
  opacity: 1;
}

/* 展开箭头 */
.ct-caret {
  flex: none;
  font-size: 18px;
  line-height: 1;
  opacity: 0.45;
  transition: transform 0.25s ease;
}

.ct-node.ct-open > .ct-link .ct-caret {
  transform: rotate(90deg);
  opacity: 0.9;
}

/* 展开态由 ct-open 控制 */

/* 子分类：默认收起，hover 时平滑展开 */
.ct-sub {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  margin-left: 26px;
  padding-left: 16px;
  border-left: 2px solid rgba(128, 128, 128, 0.22);
  transition: max-height 0.32s ease, opacity 0.26s ease, margin-top 0.32s ease,
    padding-top 0.32s ease, padding-bottom 0.32s ease;
}

/* 子分类：默认收起，点开才展开 */

/* 第三层及更深：点开才展开，鼠标划过不展开 */

.ct-sub .ct-link {
  padding: 9px 14px;
  background: transparent;
  border: 1px solid transparent;
  box-shadow: none;
  border-radius: 8px;
}

.ct-sub .ct-link:hover {
  background: var(--menu-item-bg-color);
  padding-left: 20px;
  box-shadow: none;
}

.ct-sub .ct-name {
  font-size: 14px;
  font-weight: 400;
  opacity: 0.85;
}

/* 三级及更深：缩进逐层收窄，避免深层被推到右边 */
.ct-sub .ct-sub {
  margin-left: 8px;
  padding-left: 12px;
  border-left-width: 1px;
}

.ct-sub .ct-sub .ct-link {
  padding: 8px 12px;
}

.ct-sub .ct-sub .ct-link:hover {
  padding-left: 17px;
}

.ct-sub .ct-sub .ct-name {
  font-size: 13.5px;
  opacity: 0.75;
}

.ct-sub .ct-sub .ct-count {
  opacity: 0.4;
}

.ct-sub .ct-count {
  background: transparent;
  color: var(--text-color);
  opacity: 0.45;
  font-size: 12px;
  min-width: auto;
  padding: 0 4px;
}

.ct-sub .ct-link:hover .ct-count {
  background: transparent;
  color: var(--text-color);
  opacity: 0.7;
}

/* 叶子分类：悬停展开该分类下的文章 */
.ct-articles {
  list-style: none;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  margin: 0 0 0 26px;
  padding: 0 0 0 16px;
  border-left: 2px solid rgba(128, 128, 128, 0.22);
  transition: max-height 0.32s ease, opacity 0.26s ease, margin-top 0.32s ease,
    padding-top 0.32s ease, padding-bottom 0.32s ease;
}

/* 叶子分类的文章列表：点击展开，不跟随鼠标 */
.ct-node.ct-open > .ct-articles {
  max-height: 900px;
  opacity: 1;
  margin-top: 4px;
  padding-top: 4px;
  padding-bottom: 4px;
}

/* 触屏点击展开子分类 */
.ct-node.ct-open > .ct-sub {
  max-height: 1600px;
  opacity: 1;
  margin-top: 4px;
  padding-top: 4px;
  padding-bottom: 4px;
}

.ct-articles .ct-article,
.ct-sub .ct-article {
  display: block;
  padding: 7px 12px;
  border: 0;
  border-radius: 8px;
  color: var(--text-color);
  font-size: 13.5px;
  line-height: 1.5;
  text-decoration: none;
  opacity: 0.72;
  overflow-wrap: break-word;
  transition: background 0.2s ease, opacity 0.2s ease, padding-left 0.2s ease;
}

.ct-articles .ct-article::before,
.ct-sub .ct-article::before {
  content: "·";
  margin-right: 8px;
  opacity: 0.6;
}

.ct-articles .ct-article:hover,
.ct-sub .ct-article:hover {
  background: var(--menu-item-bg-color);
  padding-left: 18px;
  opacity: 1;
}

/* 内页左上角：返回上一层 */
.page-back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin: 0 0 16px;
  padding: 7px 16px 7px 12px;
  border-radius: 999px;
  border: 1px solid rgba(128, 128, 128, 0.22);
  background: var(--content-bg-color);
  color: var(--text-color);
  font-size: 13.5px;
  line-height: 1.2;
  text-decoration: none;
  opacity: 0.75;
  transition: opacity 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.page-back:hover {
  opacity: 1;
  border-color: var(--theme-color);
  color: var(--theme-color);
}

.page-back-arrow {
  font-size: 18px;
  line-height: 1;
  margin-top: -2px;
}

.ct-empty {
  color: var(--text-color);
  opacity: 0.6;
}

/* 触屏 / 窄屏：没有 hover，第三层起靠点击展开 */
@media (hover: none), (max-width: 767px) {
  .ct-caret {
    opacity: 0.4;
  }

  .ct-node.ct-has-sub > .ct-link {
    cursor: pointer;
  }
}

/* 窄屏收紧留白 */
@media (max-width: 767px) {
  .ct-link {
    padding: 12px 12px;
    gap: 10px;
  }

  .ct-sub {
    margin-left: 12px;
    padding-left: 9px;
  }

  .ct-articles {
    margin-left: 12px;
    padding-left: 9px;
  }

  .ct-sub .ct-sub {
    margin-left: 4px;
    padding-left: 8px;
  }

  .ct-sub .ct-link,
  .ct-sub .ct-sub .ct-link {
    padding: 8px 10px;
  }
}


